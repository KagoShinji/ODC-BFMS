DATA_PROVIDER=demo
# Optional demo credentials and cookie signing secret. Use non-default values for shared demos.
DEMO_LOGIN_EMAIL=demo@odc.local
DEMO_LOGIN_PASSWORD=demo1234
DEMO_AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed for admins to create staff sign-in accounts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
# Optional. Gives each barangay a subdomain, e.g. san-isidro.bfms.example.ph.
# Use localhost:3000 locally (open san-isidro.localhost:3000). Leave blank to use /b/<slug> links.
NEXT_PUBLIC_ROOT_DOMAIN=
